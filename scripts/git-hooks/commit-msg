#!/usr/bin/env bash
# commit-msg: reject non-Conventional-Commits headers via scripts/commitlint.py.
# Installed by scripts/install-hooks.sh. Bypass (human, deliberate only):
#   git commit --no-verify ...
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec python3 "$REPO_ROOT/scripts/commitlint.py" "$1"
