# ZAYNOR local development template.
# This file contains no credentials and is safe to commit.
# ZAYNOR does not load .env automatically; pass these values through your
# shell or your process manager when starting the local API.

# Local Ollama endpoint (loopback-only by design).
ZAYNOR_OLLAMA_HOST=http://127.0.0.1:11434
ZAYNOR_OLLAMA_MODEL=hermes
ZAYNOR_OLLAMA_TIMEOUT=120

# Optional local paths used by CLI/API launch scripts.
ZAYNOR_OUTPUT_ROOT=results
ZAYNOR_CASES_ROOT=casos
